{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vamo Lite",
  "version": "0.1.0",
  "identifier": "com.vamo.lite",
  "build": { "frontendDist": "../web" },
  "app": { "withGlobalTauri": true,
    "windows": [{ "title": "Vamo Lite", "width": 1120, "height": 720, "minWidth": 720, "minHeight": 520, "resizable": true, "fullscreen": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}


